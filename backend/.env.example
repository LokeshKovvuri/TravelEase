# Database and security
DATABASE_URL=postgresql+psycopg2://travelease:change-me@localhost:5432/travelease
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application and browser access
APP_NAME=TravelEase
DEBUG=true
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Payment gateway. "mock" is local development only; never enable it in production.
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=true
PAYMENT_HOLD_MINUTES=30

# Stripe production configuration
# PAYMENT_PROVIDER=stripe
# ALLOW_MOCK_PAYMENTS=false
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional SMTP configuration for booking emails
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_USERNAME=

# Optional AI trip planner. The key is read only by the backend, never by the browser.
# Without a key, the planner still returns recommendations based on the live hotel catalogue.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
